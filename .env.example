# Copier vers .env.local et renseigner. .env.local n'est jamais versionné.
#
# .env.local = syndic-dev, la base de DÉVELOPPEMENT (jeu fictif). C'est elle que
# lisent `npm run dev` et `npm test`. La base réelle n'a pas sa place ici : ses
# clés vivent dans les variables d'environnement de Vercel (application déployée).
# La suite de tests refuse de démarrer sur une base qui n'est pas le jeu fictif.
# Les clés réelles, si elles doivent exister sur un poste, vont dans .env.reel
# (ignoré par git, chargé par rien) — jamais dans .env.production.local, que
# Next.js charge pour `next build` / `next start`.
# Voir README, « Environnements ».

# --- Supabase (projet syndic-dev) : Project Settings > API ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé de service : serveur uniquement, jamais exposée au navigateur,
# jamais utilisée pour contourner la sécurité par ligne.
SUPABASE_SERVICE_ROLE_KEY=

# Connexion directe à la base syndic-dev (migrations, chargement du seed, tests)
DATABASE_URL=

# --- Application ---
# Déploiement de démonstration seulement (Vercel, relié à syndic-dev) : DEMONSTRATION=1.
# Serveur uniquement, jamais NEXT_PUBLIC_. Voir docs/09-deploiement.md.
# DEMONSTRATION=1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Agrégateur de paiement (Wave, Orange Money) ---
# Fournisseur non arrêté : voir docs/06-decisions.md, question 2.
PAIEMENT_FOURNISSEUR=
PAIEMENT_CLE_API=
PAIEMENT_SECRET_WEBHOOK=

# --- WhatsApp Business (Meta Cloud API) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# --- Courriel transactionnel ---
EMAIL_EXPEDITEUR=
EMAIL_CLE_API=
